# Development Environment Variables
# Copy this to .env.local and update with your actual values

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/seller_dashboard_dev

# Better Auth Configuration
BETTER_AUTH_SECRET=development-secret-key-32-characters-minimum
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Node Environment
NODE_ENV=development

# Optional: Redis for rate limiting (uncomment if you have Redis running)
# REDIS_URL=redis://localhost:6379

# Optional: Admin seed token for development
ADMIN_SEED_TOKEN=dev-admin-seed-token
