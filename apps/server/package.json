{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node src/server.cjs",
    "dev:node": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "bun run dist/index.mjs",
    "check-types": "tsc -b",
    "lint": "eslint .",
    "test": "bun test",
    "verify:prod": "bun run scripts/verify-production.ts",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server"
  },
  "dependencies": {
    "@hono/node-server": "1.19.12",
    "@hono/trpc-server": "^0.4.0",
    "@seller-dashboard/api": "*",
    "@seller-dashboard/auth": "*",
    "@seller-dashboard/db": "*",
    "@seller-dashboard/env": "*",
    "@trpc/server": "^11.13.4",
    "better-auth": "1.5.5",
    "dotenv": "^17.2.2",
    "hono": "^4.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@seller-dashboard/config": "*",
    "@types/bun": "^1.3.4",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
